#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#131313')  # Obsidian
            Rectangle:
                pos: self.pos
                size: self.size

        # ── TOP BAR ─────────────────────────────────────────────────────────
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(80)
            padding: [dp(24), dp(20), dp(16), 0]
            spacing: dp(10)

            BoxLayout:
                orientation: 'vertical'
                MDLabel:
                    id: title_label
                    text: 'CONNEKTOR'
                    font_name: 'assets/fonts/Poppins-Bold.ttf'
                    font_size: '28sp'
                    bold: True
                    size_hint_y: None
                    height: dp(36)
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#00F0FF')
                MDLabel:
                    text: 'College wifi, Automated'
                    font_size: '13sp'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#B9CACB')
                    size_hint_y: None
                    height: dp(20)
            
            MDIconButton:
                icon: 'information-outline'
                pos_hint: {'center_y': .5}
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#00F0FF')
                on_release: root.show_info_dialog()

        # ── STATUS BADGE ────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            padding: [0, dp(8), 0, 0]
            pos_hint: {'center_x': .5}

            MDBoxLayout:
                id: status_badge
                size_hint: (None, None)
                size: (dp(140), dp(32))
                pos_hint: {'center_x': .5}
                radius: [16]
                md_bg_color: get_color_from_hex('#1C1B1B')
                line_color: get_color_from_hex('#00F0FF')
                line_width: 1

                MDLabel:
                    id: status_label
                    text: 'SECURED'
                    font_size: '12sp'
                    bold: True
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#00F0FF')

        # ── CONNECT BUTTON ───────────────────────────────────────────────────
        Widget:
            size_hint_y: 0.08

        BoxLayout:
            size_hint_y: None
            height: dp(240)
            pos_hint: {'center_x': .5}

            MDFloatLayout:
                pos_hint: {'center_x': .5}

                # Neon Glow ring
                MDBoxLayout:
                    id: connect_glow
                    size_hint: (None, None)
                    size: (dp(230), dp(230))
                    pos_hint: {'center_x': .5, 'center_y': .5}
                    radius: [115]
                    md_bg_color: 0.0, 0.94, 1.0, 0.1

                # Button circle (Pill shaped / Rounded Full)
                MDBoxLayout:
                    id: connect_btn
                    size_hint: (None, None)
                    size: (dp(200), dp(200))
                    pos_hint: {'center_x': .5, 'center_y': .5}
                    radius: [100]
                    md_bg_color: get_color_from_hex('#00F0FF')
                    on_touch_down:
                        if self.collide_point(*args[1].pos): root.on_connect_press()

                    MDBoxLayout:
                        orientation: 'vertical'
                        pos_hint: {'center_x': .5, 'center_y': .5}

                        MDIcon:
                            icon: 'wifi-lock'
                            halign: 'center'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#131313')
                            font_size: '48sp'

                        MDLabel:
                            text: 'CONNECT'
                            font_size: '16sp'
                            bold: True
                            halign: 'center'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#131313')
                            size_hint_y: None
                            height: dp(24)

        Widget:
            size_hint_y: 1

        # ── ACTIVE PROFILE CARD ──────────────────────────────────────────────
        MDBoxLayout:
            size_hint_y: None
            height: dp(100)
            padding: [dp(20), 0, dp(20), dp(24)]

            MDBoxLayout:
                id: profile_card
                orientation: 'horizontal'
                radius: [20]
                md_bg_color: get_color_from_hex('#1C1B1B')
                padding: [dp(20), dp(12)]
                on_touch_down:
                    if self.collide_point(*args[1].pos): root.on_profile_card_tap()
                
                BoxLayout:
                    orientation: 'vertical'
                    MDLabel:
                        text: 'ACTIVE PROFILE'
                        font_size: '10sp'
                        bold: True
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex('#B9CACB')
                        size_hint_y: None
                        height: dp(16)

                    MDLabel:
                        id: profile_name_label
                        text: 'Profile 1'
                        font_size: '18sp'
                        bold: True
                        size_hint_y: None
                        height: dp(28)
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex('#00F0FF')

                    MDLabel:
                        id: profile_index_label
                        text: 'Tonal layering enabled'
                        font_size: '11sp'
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex('#B9CACB')
                        size_hint_y: None
                        height: dp(18)
                
                MDIcon:
                    icon: 'chevron-right'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#B9CACB')
                    pos_hint: {'center_y': .5}
                    size_hint_x: None
                    width: dp(24)

        # ── BOTTOM NAV ───────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(65)
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#0E0E0E')
                Rectangle:
                    pos: self.pos
                    size: self.size

            AnchorLayout:
                anchor_x: 'center'
                MDIconButton:
                    icon: 'home'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#00F0FF')
                    on_release: app.sm.current = 'home'

            AnchorLayout:
                anchor_x: 'center'
                MDIconButton:
                    icon: 'router'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#B9CACB')
                    on_release: app.sm.current = 'profiles'

            AnchorLayout:
                anchor_x: 'center'
                MDIconButton:
                    icon: 'settings'
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#B9CACB')
                    on_release: app.sm.current = 'settings'
