#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex

<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.059, 0.059, 0.059, 1  # #0F0F0F
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'

        # ── TOP APP BAR ───────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(72)
            padding: [dp(20), 0, dp(20), 0]
            canvas.before:
                Color:
                    rgba: 0.075, 0.075, 0.075, 0.90  # #131313 90%
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 1, 1, 1, 0.08  # Card border / Divider
                Line:
                    points: [self.x, self.y, self.x + self.width, self.y]
                    width: 1

            MDIconButton:
                icon: 'web'
                theme_text_color: 'Custom'
                text_color: 0, 0.941, 1, 1  # Primary Cyan
                pos_hint: {'center_y': .5}

            MDLabel:
                id: title_label
                text: 'CONNEKTOR'
                font_name: 'assets/fonts/Poppins-Bold.ttf'
                font_size: '22sp'
                bold: True
                halign: 'center'
                theme_text_color: 'Custom'
                text_color: 0, 0.941, 1, 1
                canvas.before:
                    Color:
                        rgba: 0, 0.941, 1, 0.08
                    RoundedRectangle:
                        pos: self.center_x - dp(60), self.center_y - dp(16)
                        size: dp(120), dp(32)
                        radius: [dp(8)]

            MDIconButton:
                icon: 'wifi'
                theme_text_color: 'Custom'
                text_color: 0, 0.941, 1, 1
                pos_hint: {'center_y': .5}

        # ── MAIN CONTENT ──────────────────────────────────────────────────
        BoxLayout:
            orientation: 'vertical'
            padding: [dp(20), dp(40), dp(20), dp(20)]
            spacing: dp(40)

            # ── CONNECT BUTTON ────────────────────────────────────────────
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                size_hint_y: None
                height: dp(240)

                Widget:
                    size_hint: None, None
                    size: dp(240), dp(240)

                    # Layer 1: Outer glow ring
                    canvas.before:
                        Color:
                            id: connect_glow_color
                            rgba: 0, 0.941, 1, 0.12
                        Ellipse:
                            id: connect_outer_glow
                            pos: self.center_x - dp(120), self.center_y - dp(120)
                            size: dp(240), dp(240)

                    # Layer 2: Button body (Circle)
                    MDBoxLayout:
                        id: connect_btn_shell
                        size_hint: None, None
                        size: dp(200), dp(200)
                        pos: self.parent.center_x - dp(100), self.parent.center_y - dp(100)
                        radius: [dp(100)]
                        md_bg_color: 0.125, 0.122, 0.122, 1  # #201f1f
                        on_touch_down: if self.collide_point(*args[1].pos): root.on_connect_press()

                        canvas.after:
                            Color:
                                id: connect_glow_color
                                rgba: 0, 0.941, 1, 0.25
                            Line:
                                circle: [self.center_x, self.center_y, dp(100)]
                                width: 1.5

                        BoxLayout:
                            orientation: 'vertical'
                            pos_hint: {'center_x': .5, 'center_y': .5}
                            spacing: dp(10)

                            MDIcon:
                                icon: 'web'
                                font_size: '48sp'
                                halign: 'center'
                                theme_text_color: 'Custom'
                                text_color: 0, 0.941, 1, 1

                            MDLabel:
                                text: 'CONNECT'
                                font_name: 'assets/fonts/Poppins-Bold.ttf'
                                font_size: '20sp'
                                halign: 'center'
                                theme_text_color: 'Custom'
                                text_color: 0, 0.941, 1, 1

            # ── STATUS CHIP ───────────────────────────────────────────────
            BoxLayout:
                size_hint_y: None
                height: dp(40)
                AnchorLayout:
                    anchor_x: 'center'
                    MDBoxLayout:
                        size_hint: None, None
                        size: self.minimum_width + dp(30), dp(34)
                        radius: [dp(999)]
                        padding: [dp(16), 0]
                        canvas.before:
                            Color:
                                id: status_badge_color
                                rgba: 0, 0.941, 1, 0.08
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(999)]
                            Color:
                                id: status_border_color
                                rgba: 0, 0.941, 1, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(17)]
                                width: 1.2

                        MDLabel:
                            id: status_label
                            text: 'SECURED'
                            font_name: 'assets/fonts/Poppins-Bold.ttf'
                            font_size: '11sp'
                            halign: 'center'
                            valign: 'middle'
                            theme_text_color: 'Custom'
                            text_color: 0, 0.941, 1, 1

            Widget:
                size_hint_y: 1

            # ── ACTIVE PROFILE CARD ───────────────────────────────────────
            MDBoxLayout:
                size_hint_y: None
                height: dp(90)
                radius: [dp(24)]
                md_bg_color: 0.102, 0.102, 0.102, 0.85  # #1A1A1A 85%
                padding: [dp(20), dp(16)]
                spacing: dp(16)
                on_touch_down: if self.collide_point(*args[1].pos): root.on_profile_card_tap()

                canvas.after:
                    Color:
                        rgba: 1, 1, 1, 0.08
                    Line:
                        rounded_rectangle: [self.x, self.y, self.width, self.height, dp(24)]
                        width: 1

                # Pulse Dot
                Widget:
                    size_hint: None, None
                    size: dp(8), dp(8)
                    pos_hint: {'center_y': .5}
                    canvas:
                        Color:
                            id: pulse_dot_color
                            rgba: 0, 0.941, 1, 1
                        Ellipse:
                            pos: self.pos
                            size: self.size

                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(2)
                    MDLabel:
                        text: 'ACTIVE PROFILE'
                        font_name: 'assets/fonts/Poppins-Regular.ttf'
                        font_size: '10sp'
                        theme_text_color: 'Custom'
                        text_color: 0.725, 0.792, 0.796, 1  # TEXT_MUTED
                        opacity: 0.7
                    MDLabel:
                        id: profile_name_label
                        text: 'PROFILE NAME'
                        font_name: 'assets/fonts/Poppins-Bold.ttf'
                        font_size: '16sp'
                        theme_text_color: 'Custom'
                        text_color: 0.898, 0.886, 0.882, 1  # TEXT_PRIMARY

                BoxLayout:
                    size_hint_x: None
                    width: dp(40)
                    orientation: 'vertical'
                    MDLabel:
                      id: profile_index_hint
                      text: '1 / 3'
                      font_size: '10sp'
                      halign: 'right'
                      text_color: 0.725, 0.792, 0.796, 1
                    MDIcon:
                      icon: 'chevron-right'
                      theme_text_color: 'Custom'
                      text_color: 0.725, 0.792, 0.796, 1
                      font_size: '20sp'

        # ── BOTTOM NAVIGATION ─────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(72)
            canvas.before:
                Color:
                    rgba: 0.110, 0.106, 0.106, 0.85  # #1c1b1b 85%
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0, 0.941, 1, 0.10  # Top glow line
                Line:
                    points: [self.x, self.y + self.height, self.x + self.width, self.y + self.height]
                    width: 1

            # Tab: HOME (Active)
            BoxLayout:
                orientation: 'vertical'
                padding: [0, dp(8)]
                on_touch_down: if self.collide_point(*args[1].pos): app.sm.current = 'home'
                MDBoxLayout:
                    size_hint: None, None
                    size: dp(60), dp(40)
                    pos_hint: {'center_x': .5}
                    radius: [dp(14)]
                    md_bg_color: 0, 0.941, 1, 0.08
                    MDIcon:
                        icon: 'home'
                        theme_text_color: 'Custom'
                        text_color: 0, 0.941, 1, 1
                        pos_hint: {'center_x': .5, 'center_y': .5}
                MDLabel:
                    text: 'HOME'
                    font_name: 'assets/fonts/Poppins-Bold.ttf'
                    font_size: '10sp'
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: 0, 0.941, 1, 1
                # Glow dot below
                Widget:
                    size_hint_y: None
                    height: dp(4)
                    canvas:
                        Color:
                            rgba: 0, 0.941, 1, 0.9
                        Ellipse:
                            pos: self.center_x - dp(2), self.y
                            size: dp(4), dp(4)

            # Tab: PROFILES
            BoxLayout:
                orientation: 'vertical'
                padding: [0, dp(8)]
                on_touch_down: if self.collide_point(*args[1].pos): app.sm.current = 'profiles'
                MDIcon:
                    icon: 'access-point-network'
                    theme_text_color: 'Custom'
                    text_color: 0.518, 0.580, 0.584, 1  # Outline/Inactive
                    halign: 'center'
                MDLabel:
                    text: 'PROFILES'
                    font_name: 'assets/fonts/Poppins-Bold.ttf'
                    font_size: '10sp'
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: 0.518, 0.580, 0.584, 1

            # Tab: SETTINGS
            BoxLayout:
                orientation: 'vertical'
                padding: [0, dp(8)]
                on_touch_down: if self.collide_point(*args[1].pos): app.sm.current = 'settings'
                MDIcon:
                    icon: 'cog'
                    theme_text_color: 'Custom'
                    text_color: 0.518, 0.580, 0.584, 1
                    halign: 'center'
                MDLabel:
                    text: 'SETTINGS'
                    font_name: 'assets/fonts/Poppins-Bold.ttf'
                    font_size: '10sp'
                    halign: 'center'
                    theme_text_color: 'Custom'
                    text_color: 0.518, 0.580, 0.584, 1
