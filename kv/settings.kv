#:import dp kivy.metrics.dp
#:import get_color_from_hex kivy.utils.get_color_from_hex

<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: get_color_from_hex('#131313')
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(80)
            padding: [dp(24), dp(20), 0, 0]
            orientation: 'vertical'

            MDLabel:
                id: title_label
                text: 'SETTINGS'
                font_name: 'assets/fonts/Poppins-Bold.ttf'
                font_size: '28sp'
                bold: True
                size_hint_y: None
                height: dp(36)
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#00F0FF')

            MDLabel:
                text: 'Configure your network experience'
                font_size: '13sp'
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#B9CACB')
                size_hint_y: None
                height: dp(20)

        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(15)
                padding: [dp(20), dp(15)]
                size_hint_y: None
                height: self.minimum_height

                # ── SECTION: AUTO CONNECT ──────────────────────────────────────
                MDLabel:
                    id: appearance_section
                    text: 'AUTO CONNECT'
                    font_size: '11sp'
                    bold: True
                    size_hint_y: None
                    height: dp(24)
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#00F0FF')

                MDBoxLayout:
                    orientation: 'vertical'
                    radius: [20]
                    md_bg_color: get_color_from_hex('#1C1B1B')
                    padding: [dp(20), dp(16)]
                    spacing: dp(16)
                    size_hint_y: None
                    height: dp(90)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(55)
                        spacing: dp(15)

                        MDIcon:
                            icon: 'lightning-bolt'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#00F0FF')
                            size_hint_x: None
                            width: dp(30)
                            pos_hint: {'center_y': .5}

                        BoxLayout:
                            orientation: 'vertical'
                            pos_hint: {'center_y': .5}

                            MDLabel:
                                text: 'Auto Connect'
                                font_size: '16sp'
                                bold: True
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex('#E5E2E1')
                                size_hint_y: None
                                height: dp(24)

                            MDLabel:
                                text: 'Instantly pair with trusted hubs'
                                font_size: '12sp'
                                theme_text_color: 'Custom'
                                text_color: get_color_from_hex('#B9CACB')
                                size_hint_y: None
                                height: dp(18)

                        MDSwitch:
                            id: auto_login_toggle
                            pos_hint: {'center_y': .5}
                            on_active: root.on_auto_login_toggle(self.active)
                            thumb_color_active: get_color_from_hex('#00F0FF')
                            track_color_active: get_color_from_hex('#006970')

                # ── SECTION: COLOR THEME ─────────────────────────────────────
                MDLabel:
                    text: 'THEME SELECTOR'
                    font_size: '11sp'
                    bold: True
                    theme_text_color: 'Custom'
                    text_color: get_color_from_hex('#00F0FF')
                    size_hint_y: None
                    height: dp(24)

                MDBoxLayout:
                    orientation: 'vertical'
                    radius: [24]
                    md_bg_color: get_color_from_hex('#1C1B1B')
                    padding: [dp(24), dp(18)]
                    spacing: dp(15)
                    size_hint_y: None
                    height: dp(220)

                    MDLabel:
                        text: 'Choose your accent color. Dark Obsidian is always kept.'
                        font_size: '12sp'
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex('#B9CACB')
                        size_hint_y: None
                        height: dp(36)

                    # Row: Theme swatches
                    BoxLayout:
                        size_hint_y: None
                        height: dp(60)
                        spacing: dp(12)

                        MDRaisedButton:
                            text: 'CYAN'
                            md_bg_color: get_color_from_hex('#00F0FF')
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#131313')
                            on_release: root.on_theme_select('electric_cyan')

                        MDRaisedButton:
                            text: 'VIOLET'
                            md_bg_color: get_color_from_hex('#7000FF')
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#FFFFFF')
                            on_release: root.on_theme_select('neon_violet')

                        MDRaisedButton:
                            text: 'SOLAR'
                            md_bg_color: get_color_from_hex('#F97316')
                            on_release: root.on_theme_select('solar_orange')

                        MDRaisedButton:
                            text: 'GHOST'
                            md_bg_color: get_color_from_hex('#E5E2E1')
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#131313')
                            on_release: root.on_theme_select('ghost_white')

                    MDLabel:
                        text: 'Current theme: Quantum Link Secured'
                        font_size: '11sp'
                        theme_text_color: 'Custom'
                        text_color: get_color_from_hex('#B9CACB')
                        size_hint_y: None
                        height: dp(20)

                # ── SECTION: SYSTEM INFO ─────────────────────────────────────
                MDBoxLayout:
                    orientation: 'vertical'
                    radius: [20]
                    md_bg_color: get_color_from_hex('#1C1B1B')
                    padding: [dp(20), dp(16)]
                    spacing: dp(8)
                    size_hint_y: None
                    height: dp(100)

                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(15)

                        MDIcon:
                            icon: 'shield-check'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#00F0FF')
                            size_hint_x: None
                            width: dp(30)
                            pos_hint: {'center_y': .5}

                        MDLabel:
                            text: 'Quantum V4.0.0 Stable'
                            font_size: '14sp'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#E5E2E1')

                    BoxLayout:
                        size_hint_y: None
                        height: dp(30)
                        spacing: dp(15)

                        MDIcon:
                            icon: 'information-outline'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#B9CACB')
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: 'Made by Anup Aryal'
                            font_size: '13sp'
                            theme_text_color: 'Custom'
                            text_color: get_color_from_hex('#B9CACB')

        # ── BOTTOM NAV ───────────────────────────────────────────────────────
        BoxLayout:
            size_hint_y: None
            height: dp(65)
            canvas.before:
                Color:
                    rgba: get_color_from_hex('#0E0E0E')
                Rectangle:
                    pos: self.pos
                    size: self.size

            MDIconButton:
                icon: 'home'
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#B9CACB')
                on_release: app.sm.current = 'home'

            MDIconButton:
                icon: 'router'
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#B9CACB')
                on_release: app.sm.current = 'profiles'

            MDIconButton:
                icon: 'settings'
                theme_text_color: 'Custom'
                text_color: get_color_from_hex('#00F0FF')
                on_release: app.sm.current = 'settings'
